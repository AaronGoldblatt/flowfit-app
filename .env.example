# FlowFit Environment Variables Template
# Copy this file to .env.local and fill in your values

# Database Configuration
# For local development, use your local PostgreSQL
LOCAL_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowfit"
# For production testing locally, you can use your Neon database
DATABASE_URL="postgresql://your-neon-connection-string-here"

# BetterAuth Configuration
# Generate with: pnpm dlx @better-auth/cli@latest secret
BETTER_AUTH_SECRET="your-secret-here"

# For local development
BETTER_AUTH_URL="http://localhost:3000"

# Public environment variables (available in browser)
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# PostgreSQL Configuration (if running local database)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="flowfit"
